# ═══════════════════════════════════════════════════════════════════════════
# PyGeoVision v2.0 — .gitignore
# Covers: Python, PyGeoFetch credentials/cache, model weights, geospatial
#         data, build artifacts, notebooks, IDEs, OS files, Docker, cloud.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.dll
*.dylib

# ─── Build / Distribution ──────────────────────────────────────────────────
build/
dist/
wheels/
*.egg-info/
*.egg
MANIFEST
.eggs/
sdist/
develop-eggs/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
*.egg-link

# ─── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/
.pyenv/
pyvenv.cfg

# ─── Testing & coverage ────────────────────────────────────────────────────
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
test-results/
test-reports/
junit*.xml
/tmp_test_*/
test_output/

# ─── Type checking ─────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
.ruff_cache/

# ─── Jupyter / IPython ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py
# Keep committed notebooks; ignore auto-saves only via .ipynb_checkpoints above

# ─── PyGeoFetch — NEVER commit credentials or cache ────────────────────────
.pygeofetch/
pygeofetch_data/
*.credentials.enc
credentials.enc
pygeofetch.log
pygeofetch*.log
search_cache/
*.geojson.cache

# ─── PyGeoVision — runtime data ────────────────────────────────────────────
.pygeovision/
pygeovision.log
pygeovision*.log

# ─── Model weights & checkpoints ───────────────────────────────────────────
# Distribute via HuggingFace Hub — do not commit binary weights
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.pkl
*.pickle
*.h5
*.hdf5
*.onnx
*.tflite
*.pb
*.engine       # TensorRT
*.trt          # TensorRT
checkpoints/
model_cache/
pretrained/
weights/
saved_models/

# ─── Geospatial raster data ─────────────────────────────────────────────────
*.tif
*.tiff
*.geotiff
*.img
*.jp2
*.nc
*.hdf
*.hdf4
*.hdf5
*.h4
*.he4
*.h5
*.he5
*.zarr/
*.grib
*.grib2
*.grb
*.grb2
*.dem
*.asc
*.flt

# ─── Geospatial vector data ─────────────────────────────────────────────────
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.qpj
*.gpkg
*.gdb/

# GeoJSON — allow test fixtures; ignore search results
results.geojson
search_results.geojson
*.geojson
!tests/fixtures/
!tests/data/

# ─── Point cloud data ────────────────────────────────────────────────────────
*.laz
*.las
*.ply
*.e57
*.pcd


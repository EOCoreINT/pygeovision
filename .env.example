# PyGeoVision — Environment Variable Reference
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ── PyGeoFetch — Satellite Provider Credentials ─────────────────────────────
# Open providers below need no credentials — remove env vars you don't use.

# USGS Earth Explorer (Landsat 1–9, ASTER, MODIS)
PYGEOFETCH_USGS_USERNAME=your_usgs_username
PYGEOFETCH_USGS_PASSWORD=your_usgs_password

# NASA Earthdata (MODIS, VIIRS, ICESat-2, GEDI)
PYGEOFETCH_NASA_EARTHDATA_USERNAME=your_nasa_username
PYGEOFETCH_NASA_EARTHDATA_PASSWORD=your_nasa_password

# Copernicus Data Space (Sentinel-1/2/3/5P)
PYGEOFETCH_COPERNICUS_USERNAME=your_email@example.com
PYGEOFETCH_COPERNICUS_PASSWORD=your_copernicus_password

# Planet Labs (PlanetScope 3m, SkySat 0.5m — subscription required)
PYGEOFETCH_PLANET_API_KEY=PL-your-planet-api-key

# Sentinel Hub (on-the-fly processing — freemium)
PYGEOFETCH_SENTINEL_HUB_CLIENT_ID=your-sh-client-id
PYGEOFETCH_SENTINEL_HUB_CLIENT_SECRET=your-sh-client-secret

# OpenTopography (SRTM, COP-DEM, LiDAR — free tier)
PYGEOFETCH_OPENTOPOGRAPHY_API_KEY=your-opentopo-key

# Maxar / DigitalGlobe (WorldView — subscription)
PYGEOFETCH_MAXAR_API_KEY=your-maxar-api-key

# Airbus One Atlas (Pléiades, SPOT — subscription)
PYGEOFETCH_AIRBUS_API_KEY=your-airbus-api-key

# Google Earth Engine (service account JSON path)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Headless / Docker ────────────────────────────────────────────────────────
# Required in headless Linux environments where D-Bus/keyring is unavailable.
# With this set, credentials come from env vars above (no keyring storage).
PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring

# ── PyGeoVision Inference Server ─────────────────────────────────────────────
PGV_API_KEY=your-secret-api-key
PGV_LOG_LEVEL=INFO
PGV_WORKERS=4
PGV_PORT=8080
PGV_GPU_DEVICE=cuda

# ── HuggingFace Hub (for foundation model weights) ───────────────────────────
# Set this to avoid rate limits when downloading DINOv3 / Prithvi weights.
HF_TOKEN=hf_your-huggingface-token

# ── Monitoring / Alerts ───────────────────────────────────────────────────────
PGV_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PGV_ALERT_EMAIL=alerts@yourdomain.com

# ── MLflow Experiment Tracking ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Docker Compose ────────────────────────────────────────────────────────────
JUPYTER_TOKEN=pgvision
GRAFANA_USER=admin
GRAFANA_PASSWORD=pgvision
